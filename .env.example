NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For older Supabase projects, NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
# No service_role or secret key is required by this application.

